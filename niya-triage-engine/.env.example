# Copy to .env and fill in. Every value here is OPTIONAL.
# The triage engine, including the safety layer, runs fully without any of them.

# Enables the language-model second opinion. Without it the engine runs
# rules-only and reports `method: rules_only` in its output.
OPENAI_API_KEY=

# auto (default) = use the model if a key is present. Use "off" to force
# rules-only even when a key exists - useful for reproducible evaluation runs.
NIYA_LLM_ENABLED=auto
NIYA_LLM_MODEL=gpt-4o-mini
NIYA_LLM_TIMEOUT=12

# Where the tamper-evident decision log is written.
NIYA_AUDIT_DIR=./audit
